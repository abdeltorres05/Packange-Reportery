# Servidor
NODE_ENV=development
PORT=3000

# Seguridad: cambia este valor en producción
JWT_SECRET=cambia-este-secreto-por-uno-largo-y-aleatorio
JWT_EXPIRES_IN=8h
BCRYPT_ROUNDS=12

# Base de datos (ruta absoluta o relativa; usa :memory: solo para pruebas)
DB_PATH=./server/data/app.db

# Archivos subidos
UPLOAD_DIR=./server/uploads
MAX_UPLOAD_BYTES=5242880

# Origen permitido para el frontend en desarrollo
CLIENT_ORIGIN=http://localhost:5173

# Super administrador inicial (se crea una sola vez con npm run seed)
SUPER_ADMIN_NAME=Administrador General
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# Datos demo opcionales; solo para desarrollo. Contraseña mínima: 12 caracteres.
SEED_DEMO_DATA=false
DEMO_AGENCY_PASSWORD=
